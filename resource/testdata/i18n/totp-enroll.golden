HTTP 200
<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Set Up Two-Factor Authentication</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230f172a'/><text x='6' y='22' font-size='18' fill='%233b82f6'>⚙</text></svg>"><link rel="stylesheet" href="/admin/static/pm7.css"><style>CSS</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="sidebar-header"><h1>Set Up Two-Factor Authentication</h1><div class="sidebar-header-actions"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="false"><span class="theme-icon-moon" aria-hidden="true">&#9790;</span> <span class="theme-icon-sun" aria-hidden="true">&#9728;</span></button> <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button></div></div><nav class="sidebar-nav"></nav><div class="sidebar-bottom"> <div class="sidebar-profile"><div class="sidebar-profile-avatar" aria-hidden="true">u</div><div class="sidebar-profile-info"><div class="sidebar-profile-name">u1</div><div class="sidebar-profile-role">admin</div></div></div> <form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block"><button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout"><span class="sidebar-icon">&#x2192;</span> <span class="sidebar-label">Logout</span> <span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span></button></form></div></aside><div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div><main class="main"><button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button><div id="content"><div class="page-header"><h2>Set Up Two-Factor Authentication</h2></div><div class="pm7-card" style="max-width:28rem;padding:1.5rem;margin-bottom:1.5rem"><p style="font-size:.8125rem;color:var(--pm7-muted-foreground);margin-top:0">Scan this code with your authenticator app (Google Authenticator, 1Password, Authy, …):</p><img src="/admin/security/totp/qr.png/" width="256" height="256" alt="TOTP enrollment QR code -- scan with your authenticator app, or use the manual-entry code below" style="display:block;margin:0 auto 1rem;border-radius:.5rem"><p style="font-size:.8125rem;color:var(--pm7-muted-foreground)">Can't scan? Enter this code manually:</p><code>SECRET</code><p style="font-size:.75rem;color:var(--pm7-muted-foreground);margin-bottom:.25rem">Full setup URI (some apps accept pasting this directly):</p><code>SECRET</code></div><form method="POST" action="/admin/security/totp/confirm/" style="max-width:20rem"><input type="hidden" name="_csrf" value="CSRF"><div style="margin-bottom:1rem"><label for="totp-code" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Enter the 6-digit code from your app</label> <input id="totp-code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" maxlength="6" required autofocus class="pm7-input"></div><div style="margin-bottom:1rem"><label for="totp-confirm-password" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Confirm your current password</label> <input id="totp-confirm-password" name="current_password" type="password" autocomplete="current-password" required class="pm7-input"></div><button type="submit" class="pm7-button pm7-button--primary">Verify &amp; Enable</button></form></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>