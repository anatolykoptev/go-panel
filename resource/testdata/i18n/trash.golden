><div class="crm-table-scroll"><table class="crm-table"><thead><tr><th style="">Название</th><th style="">Создано</th><th style="width:5rem"></th></tr></thead> <tbody><tr><td style="">Альфа</td><td style="">2026-01-01</td><td style="text-align:right;white-space:nowrap"><button type="button" class="row-undo" hx-post="/admin/items/1/restore" hx-vals="{&#34;_csrf&#34;:&#34;CSRF&#34;}" aria-label="Restore 1">Вернуть</button></td></tr><tr><td style="">Бета</td><td style="">2026-01-02</td><td style="text-align:right;white-space:nowrap"><button type="button" class="row-undo" hx-post="/admin/items/2/restore" hx-vals="{&#34;_csrf&#34;:&#34;CSRF&#34;}" aria-label="Restore 2">Вернуть</button></td></tr></tbody></table></div><p style="color:var(--text-muted);font-size:.8125rem;margin-top:.5rem">Showing the 2 most recently deleted of 60.</p></section><section style="margin-bottom:2.5rem"><h3 style="font-size:1.0625rem;line-height:1.35;font-weight:600;color:var(--text-primary);margin-bottom:.75rem"><span aria-hidden="true">*</span> Сломанное </h3><p class="trash-unreadable" role="status">Could not read this resource's trash. The rows are still there — see the server log.</p></section></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>