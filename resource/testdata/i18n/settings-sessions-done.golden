<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Панель</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23141414'/><text x='6' y='22' font-size='18' fill='%234daafc'>⚙</text></svg>"><link rel="stylesheet" href="/admin/static/pm7.css"><style>CSS</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="sidebar-header"><h1>Панель</h1><div class="sidebar-header-actions"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="false"><span class="theme-icon-moon" aria-hidden="true">&#9790;</span> <span class="theme-icon-sun" aria-hidden="true">&#9728;</span></button> <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button></div></div><nav class="sidebar-nav"></nav><div class="sidebar-bottom"> <div class="sidebar-profile"><div class="sidebar-profile-avatar" aria-hidden="true">u</div><div class="sidebar-profile-info"><div class="sidebar-profile-name">u1</div><div class="sidebar-profile-role">admin</div></div></div><a class="sidebar-item" href="/admin/settings/" aria-label="Settings"><span class="sidebar-icon">&#x2699;</span> <span class="sidebar-label">Settings</span> <span class="sidebar-tooltip">Settings</span></a> <form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block"><button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout"><span class="sidebar-icon">&#x2192;</span> <span class="sidebar-label">Logout</span> <span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span></button></form></div></aside><div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div><main class="main"><button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button><div id="content"><div class="page-header"><h2>Settings</h2></div><div class="set-layout"><nav class="set-nav" aria-label="Settings sections"><div class="set-nav-group"><div class="set-nav-label">Personal</div><ul class="set-nav-list"><li><a class="set-nav-item" href="/admin/settings/profile/">Profile</a></li><li><a class="set-nav-item" href="/admin/settings/security/" aria-current="page">Security</a></li><li><a class="set-nav-item" href="/admin/settings/appearance/">Appearance</a></li></ul></div><div class="set-nav-group"><div class="set-nav-label">Workspace</div><ul class="set-nav-list"><li><a class="set-nav-item" href="/admin/settings/collection/">Сбор данных</a></li></ul></div></nav><div class="set-page"><header class="set-page-head"><h3 class="set-page-title">Security</h3></header><div role="status" style="margin-bottom:1rem"><div class="notice notice-info" role="note">Signed out on all other devices. </div></div><section class="set-section"><header class="set-head"><h3 class="set-title">Password</h3><p class="set-sub">Changing it signs you out on every other device.</p></header><div class="set-body"><form class="set-form" method="post" action="/admin/settings/security/password/" autocomplete="off"><input type="hidden" name="_csrf" value="CSRF"><div class="set-field"><label for="pw-current">Current password</label> <input class="pm7-input" id="pw-current" name="current_password" type="password" autocomplete="current-password" required maxlength="256"></div><div class="set-field"><label for="pw-new">New password</label> <input class="pm7-input" id="pw-new" name="new_password" type="password" autocomplete="new-password" required minlength="10" maxlength="256" aria-describedby="pw-new-hint"><p class="set-field-hint" id="pw-new-hint">At least 10 characters.</p></div><div class="set-field"><label for="pw-repeat">Repeat new password</label> <input class="pm7-input" id="pw-repeat" name="repeat_password" type="password" autocomplete="new-password" required maxlength="256"></div><div><button type="submit" class="btn btn-primary">Change password</button></div></form></div></section><section class="set-section"><header class="set-head"><h3 class="set-title">Sessions</h3><p class="set-sub">Sign out of devices you are signed in on elsewhere.</p></header><div class="set-rows"><div class="set-row"><div class="set-text"><div class="set-label">Sign out on all other devices</div></div><div class="set-control"><form method="post" action="/admin/settings/security/sessions/" style="margin:0"><input type="hidden" name="_csrf" value="CSRF"> <button type="submit" class="btn btn-secondary">Logout</button></form></div></div></div></section><section class="set-section"><header class="set-head"><h3 class="set-title">Two-factor sign-in</h3><p class="set-sub">A code from your phone in addition to the password.</p></header><div class="set-rows"><div class="set-row"><div class="set-text"><div class="set-label">Off</div></div><div class="set-control"><a class="btn btn-secondary" href="/admin/security/totp/enroll/">Turn on</a></div></div></div></section></div></div></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>