<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Панель</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23141414'/><text x='6' y='22' font-size='18' fill='%234daafc'>⚙</text></svg>"><link rel="stylesheet" href="/admin/static/pm7.css"><style>CSS</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="sidebar-header"><h1>Панель</h1><div class="sidebar-header-actions"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="false"><span class="theme-icon-moon" aria-hidden="true">&#9790;</span> <span class="theme-icon-sun" aria-hidden="true">&#9728;</span></button> <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button></div></div><nav class="sidebar-nav"></nav><div class="sidebar-bottom"> <div class="sidebar-profile"><div class="sidebar-profile-avatar" aria-hidden="true">u</div><div class="sidebar-profile-info"><div class="sidebar-profile-name">u1</div><div class="sidebar-profile-role">admin</div></div></div><a class="sidebar-item" href="/admin/settings/" aria-label="Settings"><span class="sidebar-icon">&#x2699;</span> <span class="sidebar-label">Settings</span> <span class="sidebar-tooltip">Settings</span></a> <form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block"><button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout"><span class="sidebar-icon">&#x2192;</span> <span class="sidebar-label">Logout</span> <span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span></button></form></div></aside><div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div><main class="main"><button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button><div id="content"><div class="page-header"><h2>Settings</h2></div><div class="set-layout"><nav class="set-nav" aria-label="Settings sections"><div class="set-nav-group"><div class="set-nav-label">Personal</div><ul class="set-nav-list"><li><a class="set-nav-item" href="/admin/settings/profile/">Profile</a></li><li><a class="set-nav-item" href="/admin/settings/security/">Security</a></li><li><a class="set-nav-item" href="/admin/settings/appearance/" aria-current="page">Appearance</a></li></ul></div><div class="set-nav-group"><div class="set-nav-label">Workspace</div><ul class="set-nav-list"><li><a class="set-nav-item" href="/admin/settings/collection/">Сбор данных</a></li></ul></div></nav><div class="set-page"><header class="set-page-head"><h3 class="set-page-title">Appearance</h3></header><section class="set-section"><div class="set-rows"><div class="set-row"><div class="set-text"><div class="set-label">Theme</div><p class="set-hint">How the panel looks. Saved for you and applied at once.</p></div><div class="set-control"><fieldset class="seg-group"><legend class="seg-legend">Theme</legend><div class="seg"><label class="seg-opt"><input type="radio" name="theme-skin" value="graphite" checked> <span class="seg-swatch" aria-hidden="true" style="--sw-lg:#f3f3f3;--sw-lt:#ffffff;--sw-li:#242424;--sw-la:#005fb8;--sw-dg:#141414;--sw-dt:#1f1f1f;--sw-di:#d6d6d6;--sw-da:#0078d4;"><i></i></span> <span class="seg-label">Graphite</span></label><label class="seg-opt"><input type="radio" name="theme-skin" value="iris"> <span class="seg-swatch" aria-hidden="true" style="--sw-lg:#eef0f6;--sw-lt:#ffffff;--sw-li:#141729;--sw-la:#5046e4;--sw-dg:#0f1120;--sw-dt:#171a2c;--sw-di:#eceef6;--sw-da:#8b84ff;"><i></i></span> <span class="seg-label">Iris</span></label></div></fieldset></div></div><div class="set-row"><div class="set-text"><div class="set-label">Mode</div><p class="set-hint">Also switchable with the sun and moon button in the menu.</p></div><div class="set-control"><fieldset class="seg-group"><legend class="seg-legend">Mode</legend><div class="seg"><label class="seg-opt"><input type="radio" name="theme-mode" value="light"> <span class="seg-icon" aria-hidden="true">&#9728;</span> <span class="seg-label">Light</span></label> <label class="seg-opt"><input type="radio" name="theme-mode" value="dark" checked> <span class="seg-icon" aria-hidden="true">&#9790;</span> <span class="seg-label">Dark</span></label></div></fieldset></div></div></div></section></div></div></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>