<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Панель</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23141414'/><text x='6' y='22' font-size='18' fill='%234daafc'>⚙</text></svg>"><link rel="stylesheet" href="/admin/static/pm7.css"><style>CSS</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="sidebar-header"><h1>Панель</h1><div class="sidebar-header-actions"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="false"><span class="theme-icon-moon" aria-hidden="true">&#9790;</span> <span class="theme-icon-sun" aria-hidden="true">&#9728;</span></button> <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button></div></div><nav class="sidebar-nav"><div class="sidebar-group"><button type="button" class="sidebar-group-label" data-group="Данные" aria-expanded="true">Данные</button><div class="sidebar-group-items"><a class="sidebar-item pm7-sidebar-item active pm7-sidebar-item--active" href="/admin/items" aria-label="Записи" style="anchor-name: --nav-items;" aria-current="page"><span class="sidebar-icon">*</span> <span class="sidebar-label">Записи</span> <span class="sidebar-tooltip" style="position-anchor: --nav-items;">Записи</span></a><a class="sidebar-item pm7-sidebar-item" href="/admin/broken" aria-label="Сломанное" style="anchor-name: --nav-broken;"><span class="sidebar-icon">*</span> <span class="sidebar-label">Сломанное</span> <span class="sidebar-tooltip" style="position-anchor: --nav-broken;">Сломанное</span></a><a class="sidebar-item pm7-sidebar-item" href="/admin/nothing" aria-label="Пусто" style="anchor-name: --nav-nothing;"><span class="sidebar-label">Пусто</span> <span class="sidebar-tooltip" style="position-anchor: --nav-nothing;">Пусто</span></a></div></div><div class="sidebar-group"><button type="button" class="sidebar-group-label" data-group="System" aria-expanded="true">System</button><div class="sidebar-group-items"><a class="sidebar-item pm7-sidebar-item" href="/admin/trash" aria-label="Trash" style="anchor-name: --nav-trash;"><span class="sidebar-icon">🗑</span> <span class="sidebar-label">Trash</span> <span class="sidebar-tooltip" style="position-anchor: --nav-trash;">Trash</span></a></div></div></nav><div class="sidebar-bottom"> <div class="sidebar-profile"><div class="sidebar-profile-avatar" aria-hidden="true">u</div><div class="sidebar-profile-info"><div class="sidebar-profile-name">u1</div><div class="sidebar-profile-role">admin</div></div></div><a class="sidebar-item" href="/admin/settings" aria-label="Settings"><span class="sidebar-icon">&#x2699;</span> <span class="sidebar-label">Settings</span> <span class="sidebar-tooltip">Settings</span></a> <form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block"><button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout"><span class="sidebar-icon">&#x2192;</span> <span class="sidebar-label">Logout</span> <span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span></button></form></div></aside><div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div><main class="main"><button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button><div id="content"><div class="page-header"><h2>Edit Записи</h2><a href="/admin/items" style="font-size:.8125rem;color:var(--text-secondary);text-decoration:none">&larr; Back to list</a></div><div role="tablist" aria-label="Locale" style="display:flex;gap:.375rem;margin-bottom:1rem;border-bottom:1px solid var(--pm7-border);padding-bottom:.5rem"><span role="tab" aria-selected="true" style="padding:.25rem .625rem;border-radius:.375rem;font-size:.8125rem;font-weight:600;background:var(--pm7-primary);color:var(--pm7-primary-foreground)">RU</span><a role="tab" aria-selected="false" href="/admin/items/1/edit?locale=en" style="padding:.25rem .625rem;border-radius:.375rem;font-size:.8125rem;text-decoration:none;color:var(--pm7-foreground);border:1px solid var(--pm7-border)">EN</a></div><form method="POST" action="/admin/items/1/save?locale=ru" style="max-width:40rem"><input type="hidden" name="_csrf" value="CSRF"> <div style="margin-bottom:1rem"><label for="field-name" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Название <span style="color:var(--negative);margin-left:.125rem" aria-hidden="true">*</span> <span style="margin-left:.375rem;padding:.0625rem .3125rem;border-radius:.25rem;font-size:.6875rem;font-weight:600;letter-spacing:.03em;background:var(--pm7-muted);color:var(--pm7-muted-foreground)">RU</span></label> <input id="field-name" name="name" type="text" value="Альфа" placeholder="" required class="pm7-input"> </div><div style="margin-bottom:1rem"><label for="field-qty" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Количество </label> <input id="field-qty" name="qty" type="number" value="" placeholder="" class="pm7-input"> </div><div style="margin-bottom:1rem"><label for="field-day" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">День </label> <input id="field-day" name="day" type="date" value="" class="pm7-input"> </div><div style="margin-bottom:1rem"><label for="field-at" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Момент </label> <input id="field-at" name="at" type="datetime-local" value="" class="pm7-input"> </div><div style="margin-bottom:1rem"><label for="field-kind" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Вид </label> <select id="field-kind" name="kind" class="pm7-input"><option value="">— select —</option> <option value="a">Первый</option></select> </div><div style="margin-bottom:1rem"><label for="field-meta" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Данные </label> <textarea id="field-meta" name="meta" placeholder="" rows="6" class="pm7-input" style="resize:vertical;font-family:var(--font-mono);font-size:.8125rem"></textarea> </div><div style="margin-bottom:1rem"><label for="field-flag" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Флаг </label> <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer"><input id="field-flag" name="flag" type="checkbox" value="true" class="pm7-checkbox"> <span style="font-size:.875rem;color:var(--pm7-foreground)">Флаг</span></label> </div><div style="display:flex;gap:.75rem;margin-top:1.5rem"><button type="submit" class="pm7-button pm7-button--primary">Save Changes</button> <a href="/admin/items" class="pm7-button pm7-button--outline" style="text-decoration:none">Cancel</a></div></form></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>