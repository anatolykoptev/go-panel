<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Set Up Two-Factor Authentication</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23141414'/><text x='6' y='22' font-size='18' fill='%234daafc'>⚙</text></svg>"><link rel="stylesheet" href="/admin/static/pm7.css"><style>CSS</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="sidebar-header"><h1>Set Up Two-Factor Authentication</h1><div class="sidebar-header-actions"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="false"><span class="theme-icon-moon" aria-hidden="true">&#9790;</span> <span class="theme-icon-sun" aria-hidden="true">&#9728;</span></button> <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button></div></div><nav class="sidebar-nav"></nav><div class="sidebar-bottom"> <div class="sidebar-profile"><div class="sidebar-profile-avatar" aria-hidden="true">u</div><div class="sidebar-profile-info"><div class="sidebar-profile-name">u1</div><div class="sidebar-profile-role">admin</div></div></div> <form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block"><button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout"><span class="sidebar-icon">&#x2192;</span> <span class="sidebar-label">Logout</span> <span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span></button></form></div></aside><div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div><main class="main"><button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button><div id="content"><div class="page-header"><h2>Set Up Two-Factor Authentication</h2></div><form method="POST" action="/admin/security/totp/enroll/" style="max-width:20rem"><input type="hidden" name="_csrf" value="CSRF"><div style="margin-bottom:1rem"><label for="totp-reauth-password" style="display:block;font-size:.875rem;color:var(--pm7-muted-foreground);margin-bottom:.375rem">Confirm your current password</label> <input id="totp-reauth-password" name="current_password" type="password" autocomplete="current-password" required autofocus class="pm7-input"></div><button type="submit" class="pm7-button pm7-button--primary">Continue</button></form></div></main></div><script src="/admin/static/htmx.min.js"></script><script src="/admin/static/pm7.js"></script><script src="/admin/static/admin.js" defer></script></body></html>